@model IEnumerable<DXWebApplication4.Models.Product>

@{
    ViewBag.Title = "Danh sách sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Danh sách sản phẩm</h2>

<p>
    @Html.ActionLink("Tạo sản phẩm mới", "Create", null, new { @class = "btn btn-primary" })
</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Debug"] != null)
{
    <div class="alert alert-info">@TempData["Debug"]</div>
}

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tên sản phẩm</th>
                <th>Số lượng variant</th>
                <th>Số lượng hình ảnh</th>
                <th>Số lượng tài liệu</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.IDPro</td>
                    <td>@product.TenPro</td>
                    <td>@product.ProductVariants.Count</td>
                    <td>
                        @{
                            var imageCount = product.ProductVariants.SelectMany(v => v.Images).Count();
                        }
                        @imageCount
                    </td>
                    <td>@product.Notes.Count</td>
                    <td>
                        @Html.ActionLink("Chi tiết", "Details", new { id = product.IDPro }, new { @class = "btn btn-info btn-sm" }) |
                        @Html.ActionLink("Sửa", "Edit", new { id = product.IDPro }, new { @class = "btn btn-warning btn-sm" }) |
                        @Html.ActionLink("Xóa", "Delete", new { id = product.IDPro }, new { @class = "btn btn-danger btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <strong>Thông báo:</strong> Chưa có sản phẩm nào. @Html.ActionLink("Tạo sản phẩm đầu tiên", "Create")
    </div>
}
