@model DXWebApplication4.Models.Product
@using System.Linq
@using System.Web

@{
    ViewBag.Title = "Chi tiết & chỉnh sửa sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var firstVariantId = Model.ProductVariants.FirstOrDefault()?.IDVariant;
}

<div class="main-card">
    <h2>Chi tiết & chỉnh sửa sản phẩm</h2>
    <div style="margin: 16px 0;">
        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
    </div>

    <!-- Form thêm / chỉnh sửa biến thể -->
    @using (Html.BeginForm("UpdateVariant", "Product", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "syncHiddenTenPro(); setVariantIdFromGrid();" }))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(m => m.IDPro)
        @Html.Hidden("SelectedVariantId", firstVariantId)
        @Html.Hidden("TenPro", Model.TenPro) <!-- Hidden để MVC bind giá trị TenPro -->

        @Html.DevExpress().FormLayout(settings =>
        {
            settings.Name = "variantEditForm";
            settings.Width = Unit.Percentage(100);

            settings.Items.AddGroupItem(group =>
            {
                group.Caption = "Thêm / Chỉnh sửa biến thể";

                // Tên sản phẩm
                group.Items.Add(i =>
                {
                    i.Caption = "Tên sản phẩm";
                    i.NestedExtension().TextBox(tb =>
                    {
                        tb.Name = "TenPro"; 
                        tb.Width = Unit.Percentage(100);
                        tb.Properties.ClientSideEvents.Init = $"function(s,e){{ s.SetValue('{Model.TenPro}'); }}";
                    });
                });

                // Chọn Size
                group.Items.Add(i =>
                {
                    i.Caption = "Chọn Size";
                    i.NestedExtension().ComboBox(cb =>
                    {
                        cb.Name = "SelectedSize";
                        cb.Properties.TextField = "TenSize";
                        cb.Properties.ValueField = "IDSize";
                        cb.Properties.ValueType = typeof(int);
                        cb.Properties.ClientInstanceName = "cbSize";
                        cb.Properties.DataSource = ViewBag.Sizes;
                        cb.Width = Unit.Percentage(100);
                    });
                });

                // Chọn Color
                group.Items.Add(i =>
                {
                    i.Caption = "Chọn Màu";
                    i.NestedExtension().ComboBox(cb =>
                    {
                        cb.Name = "SelectedColor";
                        cb.Properties.TextField = "TenColor";
                        cb.Properties.ValueField = "IDColor";
                        cb.Properties.ValueType = typeof(int);
                        cb.Properties.ClientInstanceName = "cbColor";
                        cb.Properties.DataSource = ViewBag.Colors;
                        cb.Width = Unit.Percentage(100);
                    });
                });

                // Upload hình ảnh
                group.Items.Add(i =>
                {
                    i.Caption = "Upload hình ảnh";
                    i.NestedExtension().UploadControl(u =>
                    {
                        u.Name = "files";
                        u.ShowUploadButton = true;
                        u.ShowProgressPanel = true;
                        u.ValidationSettings.AllowedFileExtensions = new[] { ".jpg", ".jpeg", ".png", ".gif" };
                    });
                });
            });

            // Nút Lưu
            settings.Items.Add(i =>
            {
                i.ShowCaption = DevExpress.Utils.DefaultBoolean.False;
                i.NestedExtension().Button(b =>
                {
                    b.Name = "btnSaveVariant";
                    b.Text = "Lưu biến thể";
                    b.UseSubmitBehavior = true;
                    b.RenderMode = DevExpress.Web.ButtonRenderMode.Button;
                });
            });
        }).GetHtml()
    }

    <hr />

    <h4>Biến thể sản phẩm</h4>
    @Html.DevExpress().GridView(settings =>
    {
        settings.Name = "gvVariants";
        settings.KeyFieldName = "IDVariant";
        settings.CallbackRouteValues = new { Controller = "Product", Action = "Details", id = Model.IDPro };
        settings.SettingsPager.PageSize = 10;
        settings.SettingsBehavior.AllowSelectByRowClick = true;
        settings.SettingsBehavior.AllowSelectSingleRowOnly = true;
        settings.SettingsBehavior.ColumnResizeMode = DevExpress.Web.ColumnResizeMode.Control;
        settings.Settings.ShowFilterRow = true;
        settings.SettingsAdaptivity.AdaptivityMode = DevExpress.Web.GridViewAdaptivityMode.Off;

        // Các cột
        settings.Columns.Add(c =>
        {
            c.FieldName = "IDVariant";
            c.Caption = "Mã biến thể";
            c.Width = Unit.Pixel(100);
        });
        settings.Columns.Add(c =>
        {
            c.Caption = "Tên sản phẩm";
            c.UnboundType = DevExpress.Data.UnboundColumnType.String;
            c.SetDataItemTemplateContent(cell =>
            {
                ViewContext.Writer.Write(HttpUtility.HtmlEncode(Model.TenPro));
            });
            c.ReadOnly = true;
            c.Width = Unit.Pixel(200);
        });
        settings.Columns.Add(c =>
        {
            c.Caption = "Size";
            c.UnboundType = DevExpress.Data.UnboundColumnType.String;
            c.SetDataItemTemplateContent(cell =>
            {
                var sizeName = System.Web.UI.DataBinder.Eval(cell.DataItem, "Size.TenSize") as string;
                if (!string.IsNullOrEmpty(sizeName))
                    ViewContext.Writer.Write(HttpUtility.HtmlEncode(sizeName));
            });
        });
        settings.Columns.Add(c =>
        {
            c.Caption = "Color";
            c.UnboundType = DevExpress.Data.UnboundColumnType.String;
            c.SetDataItemTemplateContent(cell =>
            {
                var colorName = System.Web.UI.DataBinder.Eval(cell.DataItem, "Color.TenColor") as string;
                if (!string.IsNullOrEmpty(colorName))
                    ViewContext.Writer.Write(HttpUtility.HtmlEncode(colorName));
            });
        });
        settings.Columns.Add(c =>
        {
            c.Caption = "Hình ảnh";
            c.UnboundType = DevExpress.Data.UnboundColumnType.Object;
            c.SetDataItemTemplateContent(cell =>
            {
                int idVariant;
                if (cell.KeyValue != null && int.TryParse(cell.KeyValue.ToString(), out idVariant))
                {
                    var variant = Model.ProductVariants.FirstOrDefault(v => v.IDVariant == idVariant);
                    if (variant != null)
                    {
                        foreach (var img in variant.Images)
                        {
                            ViewContext.Writer.Write($@"
                            <div style='display:inline-block; margin-right:6px; text-align:center;'>
                                <img src='{img.URL}' style='height:60px;border-radius:4px;border:1px solid #eee;' />
                                <br/>
                                <a href='/Product/DeleteImage?idImage={img.IDImg}&productId={Model.IDPro}' 
                                onclick='return confirm(""Bạn có chắc muốn xóa ảnh này?"")'>Xóa</a>
                            </div>");
                        }
                    }
                }
            });
        });
        settings.Columns.Add(c => 
        { 
            c.Caption = "Ghi chú (Note)"; 
            c.UnboundType = DevExpress.Data.UnboundColumnType.String; 
            c.SetDataItemTemplateContent(cell => 
            { 
                var notes = Model.Notes; 
                if (notes != null && notes.Any()) 
                { 
                    foreach (var note in notes) 
                    { 
                        ViewContext.Writer.Write($"<a href=\"{note.NoiDung}\" target=\"_blank\">Tài liệu</a>&nbsp;"); 
                    } 
                } 
            });
        });
    }).Bind(Model.ProductVariants).GetHtml()
</div>

<script>
function setVariantIdFromGrid() {
    var grid = ASPxClientControl.GetControlCollection().GetByName("gvVariants");
    if (!grid) return;

    var selectedRowIndex = grid.GetFocusedRowIndex();
    if (selectedRowIndex >= 0) {
        var key = grid.GetRowKey(selectedRowIndex);
        document.querySelector('input[name="SelectedVariantId"]').value = key;
    }
}

// Đồng bộ giá trị DevExpress TextBox vào hidden trước submit
function syncHiddenTenPro() {
    var tb = MVCxClientControl.GetControlCollection().GetByName("TenPro_Temp");
    if(tb) {
        var hidden = document.querySelector('input[name="TenPro"]');
        if(hidden) hidden.value = tb.GetValue(); 
    }
}
</script>
